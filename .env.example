# ==============================================================================
# AgentWatch Configuration Template
# ==============================================================================

# Gemini API Key (Optional for mock mode; required for live Gemini 2.5 Flash calls)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_key_here

# Mode toggle: 'true' to run fast scenario-aware mock agent & auditor without consuming quota.
# Set to 'false' once you configure GEMINI_API_KEY.
MOCK_MODE=true

# Ingestion API base URL (default: http://127.0.0.1:8000)
AGENTWATCH_API_URL=http://127.0.0.1:8000

# SQLite Persistent Database URL
DATABASE_URL=sqlite:///./traces.db
